GITLAB_HOST=gitlab.host.com
GITLAB_HTTP_PORT=80
GITLAB_HTTPS_PORT=443
GITLAB_SSH_PORT=2222
GITLAB_REGISTRY_PORT=5005
GITLAB_SIGNUP_ENABLED=false

GITLAB_SAML_IDP_SSO_URL=https://login.microsoftonline.com/ID_HERE/saml2
GITLAB_IMAGE=gitlab/gitlab-ce:latest
GITLAB_RUNNER_IMAGE=gitlab/gitlab-runner:latest
POSTGRES_IMAGE=postgres:16-alpine

GITLAB_CONTAINER_NAME=gitlab
GITLAB_RUNNER_CONTAINER_NAME=gitlab-runner
POSTGRES_CONTAINER_NAME=postgres

GITLAB_DB_HOST=postgres
GITLAB_DB_NAME=gitlabhq_production
GITLAB_DB_USER=gitlab
GITLAB_DB_PASSWORD='SECURE_PASSWORD'

DEVOPS_GROUP_NAME=DevOps
DEVOPS_GROUP_PATH=devops

MIRROR_PROJECT_NAME=mirror
MIRROR_LOCAL_DIR=projects/mirror

MAINT_PROJECT_NAME=maint
MAINT_LOCAL_DIR=projects/maint

DEVOPS_RUNNER_DESCRIPTION=docker-runner-devops
DEVOPS_RUNNER_TAGS=devops

SSH_KEY_COMMENT=gitlab-local

DEVOPS_GROUP_ID=2

